# PostgreSQL / PostGIS
DB_NAME=ftdb
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5435
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=${REDIS_HOST}:${REDIS_PORT}

# Ingestion server
# Public: device/simulator ingestion
LISTEN_ADDR=:8080

# Internal-only: metrics, debug, health, live dashboard feed
ADMIN_ADDR=:9090

# PostgreSQL DSN
PG_DSN=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSLMODE}

# Ingest Backpressure / Connection Policy
# Allowed: block, drop_oldest, drop_newest
OVERFLOW_POLICY=drop_oldest

# Close idle device connections after this duration
IDLE_TIMEOUT=90s

# Connection accept rate limiting
ACCEPT_RATE=500
ACCEPT_BURST=200

# Cold-path PostgreSQL batching
COLDPATH_BATCH_WINDOW=1s
COLDPATH_BATCH_SIZE=500
