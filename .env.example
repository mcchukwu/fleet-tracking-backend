# PostgreSQL / PostGIS
DB_HOST=localhost
DB_PORT=5435
DB_NAME=fleet_tracking
DB_USER=fleet
DB_PASSWORD=change_me
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379

# Ingest server
LISTEN_ADDR=:8080
ADMIN_ADDR=:9090

# Ingest behavior
# Allowed: block, drop_oldest, drop_newest
OVERFLOW_POLICY=drop_oldest

# Go duration format: 30s, 1m, 90s, etc.
IDLE_TIMEOUT=90s

# Sustained acceptance rate
ACCEPT_RATE=500

# Burst capacity
ACCEPT_BURST=200
